rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Core Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\+]+$');
    }

    // --- Collection: Users ---
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || resource == null);
      allow create, update: if isOwner(userId) 
        && request.resource.data.keys().hasAll(['userId', 'phoneNumber', 'walletBalance'])
        && request.resource.data.userId == userId;
      allow delete: if isOwner(userId);
    }

    // --- Collection: Saved Locations ---
    match /savedLocations/{locationId} {
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'label', 'address']);
      allow update: if isSignedIn() 
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }

    // --- Collection: Rides ---
    match /rides/{rideId} {
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'pickup', 'destination', 'status', 'createdAt']);
      allow update: if isSignedIn() 
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }
  }
}
